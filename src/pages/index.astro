---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import WorkCard from "@/components/WorkCard.astro";
import VideoPlayer from "@/components/VideoPlayer.astro";
import { site } from "@/data/site";
import { selectedWorks } from "@/data/works";
import { archiveCategories } from "@/data/archive";
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-title">
    <video class="hero-image" autoplay muted loop playsinline poster="/images/hero.png">
      <source src="/videos/hero3.mp4" type="video/mp4" />
    </video>
    <div class="hero-grid">
      <Header section="Video" inset />
      <h1 id="hero-title">
        {site.heroTitle.map((line, index) => (
          <span>
            {line}
            {index === 0 && <small>(intro)</small>}
          </span>
        ))}
      </h1>
      <p class="hero-note">
        {site.heroNote.map((line) => (
          <>
            {line}
            <br />
          </>
        ))}
        <span class="short-rule" />
      </p>
      <div class="hero-location hero-contacts">
        <a href="mailto:valko.oleksandr.v@gmail.com" aria-label="Email Oleksandr Valko">
          <span class="email-full">VALKO.OLEKSANDR.V@GMAIL.COM</span>
          <span class="email-short">EMAIL</span>
        </a>
        <a href="https://www.instagram.com/axfontain/">INSTAGRAM</a>
      </div>
      <a class="scroll-marker" href="#work">
        [ Scroll ]<span aria-hidden="true"></span>
      </a>
    </div>
  </section>
  <section class="section selected-work" id="work" aria-labelledby="work-title">
    <div class="section-heading">
      <h2 id="work-title">Selected Work</h2>
      <p>[ 01 — {String(selectedWorks.length).padStart(2, "0")} ]</p>
    </div>
    <div class="selected-grid">
      {selectedWorks.map((work, index) => (
        <WorkCard work={work} index={index} variant={work.featuredSize ?? "medium"} />
      ))}
    </div>
  </section>
  <section class="about-band" aria-labelledby="about-title">
    <div>
      <p class="eyebrow">About</p>
      <h2 id="about-title">
        {site.aboutHeading.map((line) => (
          <>
            {line}
            <br />
          </>
        ))}
      </h2>
    </div>
    <div class="about-copy">
      <p>{site.homeAbout}</p>
      <a class="text-link" href="/about/">
        More about me <span aria-hidden="true">→</span>
      </a>
    </div>
    <img
      class="about-image"
      src={site.aboutImage}
      alt="Placeholder: a cinema camera monitor on set"
      loading="lazy"
    />
  </section>
  <section class="archive-teaser" aria-labelledby="archive-title">
    <a class="archive-title-link" href="/archive/">
      <p class="eyebrow">[ More work ]</p>
      <h2 id="archive-title">Archive</h2>
    </a>
    <ul class="archive-categories">
      {archiveCategories.map((category) => (
        <li>
          <a href={`/archive/?category=${category.id}`}>
            {category.label}
            <span>({category.count})</span>
          </a>
        </li>
      ))}
    </ul>
    {site.archiveVideo ? (
      <video
        class="archive-teaser-media"
        src={site.archiveVideo}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={site.archiveImage || undefined}
        aria-hidden="true"
      />
    ) : site.archiveImage && (
      <img class="archive-teaser-media" src={site.archiveImage} alt="" loading="lazy" />
    )}
  </section>
  <VideoPlayer />
</BaseLayout>
